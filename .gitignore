# ==========================================
# Datasets & Large Data Files (Strictly Ignored)
# ==========================================
# All raw dataset formats are strictly ignored to prevent pushing large files (>20MB) to Git.
# Run 'python download_dataset.py' to download the dataset locally after cloning.
*.xlsx
*.xls
*.csv
*.tsv
*.parquet
*.feather
*.h5
*.hdf5
*.zip
*.tar.gz
*.gz
*.tmp
*.bak

# Preserve the dataset folder structure on GitHub:
!dataset/
!dataset/.gitkeep

# ==========================================
# Scratch Scripts & System Logs
# ==========================================
*.log
.system_generated/
